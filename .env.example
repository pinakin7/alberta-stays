# Optional API port. Vite's development proxy expects 3001.
PORT=3001

# Optional storage: off by default; keep false until migrations and secrets are ready.
ENABLE_LISTING_STORAGE=false
# Set privately in Render / local .env. Never commit real connection strings.
# DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST/DB?sslmode=verify-full
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=verify-full
# ADMIN_INGEST_TOKEN=GENERATE_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# REPLIERS_API_KEY=YOUR_AUTHORIZED_SERVER_SIDE_KEY
# Public display requires separate approval of MLS/license requirements.
LISTING_PUBLICATION_AUTHORIZED=false
# Used by the local admin CLI only. Keep tokens out of browser code.
APP_URL=http://localhost:3001
